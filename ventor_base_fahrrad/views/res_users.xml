<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="res_user_form_inherit_favorite_warehouse" model="ir.ui.view">
        <field name="name">res.users.form.inherit.favorite.warehouse</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="ventor_base.res_user_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allowed_warehouse_ids']" position="after">
                <field name="favorite_warehouse_id"
                       domain="[('id', 'in', allowed_warehouse_ids)]"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
